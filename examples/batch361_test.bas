' batch 361: single-line MACRO FUNCTION, MACROTEMP uniqueness, and EXIT MACRO.
#COMPILE EXE
#DIM ALL

MACRO FUNCTION ADDONE(x) = ((x)+1)

MACRO ACCUM(a)
  MACROTEMP t
  LOCAL t AS LONG
  t = (a)
  gSum = gSum + t
  IF t = 0 THEN EXIT MACRO
  gSum = gSum + 100
END MACRO

GLOBAL gSum AS LONG

FUNCTION PBMAIN() AS LONG
  LOCAL n AS LONG
  n = ADDONE(41)
  ACCUM(3)
  ACCUM(0)
  PRINT "N="; n; " SUM="; gSum
  IF n <> 42 THEN FUNCTION = 1 : EXIT FUNCTION
  IF gSum <> 103 THEN FUNCTION = 2 : EXIT FUNCTION
  FUNCTION = 0
END FUNCTION
