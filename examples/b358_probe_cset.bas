#COMPILE EXE
#CONSOLE ON
FUNCTION PBMAIN () AS LONG
  LOCAL a AS STRING * 24
  LOCAL b AS STRING * 20
  a = "COOL COOL COOL COOL COOL"
  CSET ABS a = "..PowerBASIC.."
  PRINT "["; a; "] len="; LEN(a)
  IF a = "COOL ..PowerBASIC.. COOL" THEN PRINT "ABS OK" ELSE PRINT "ABS BAD"
  CSET b = "PowerBASIC" USING "*"
  PRINT "["; b; "] len="; LEN(b)
  IF b = "*****PowerBASIC*****" THEN PRINT "USING OK" ELSE PRINT "USING BAD"
  FUNCTION = 0
END FUNCTION