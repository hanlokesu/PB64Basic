#COMPILE EXE
#DIM ALL

TYPE ABCD1
  F AS DWORD
  G AS LONG
  H AS SINGLE
END TYPE

TYPE ABCD2
  D AS DWORD
  E AS DOUBLE
  ABCD1
END TYPE

TYPE ABCD3
  A AS LONG
  ABCD2
  C AS LONG
END TYPE

FUNCTION PBMAIN () AS LONG
  LOCAL X AS ABCD3
  X.A = 10
  X.C = 20
  X.H = 1.5
  X.D = 7
  X.E = 2.5
  X.F = 3
  X.G = 4
  OPEN "out278.txt" FOR OUTPUT AS #1
  PRINT #1, X.A
  PRINT #1, X.C
  PRINT #1, X.D
  PRINT #1, X.E
  PRINT #1, X.H
  PRINT #1, LEN(X)
  CLOSE #1
  FUNCTION = 0
END FUNCTION
