FUNCTION PBMAIN() AS LONG
  DIM s AS STRING
  s = CHR$(65 TO 69)
  IF LEN(s) <> 5 THEN PRINT "FAIL CHR$ range" : FUNCTION = 1 : EXIT FUNCTION
  s = CHR$(5 TO 2)
  IF LEN(s) <> 0 THEN PRINT "FAIL CHR$ range inverted" : FUNCTION = 1 : EXIT FUNCTION
  PRINT "batch337 self-check OK"
  FUNCTION = 0
END FUNCTION
