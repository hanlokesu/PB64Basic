FUNCTION PBMAIN() AS LONG
  DIM s AS STRING
  s = STRING$(5, 65)
  IF LEN(s) <> 5 THEN PRINT "FAIL STRING$" : FUNCTION = 1 : EXIT FUNCTION
  s = STRING$(-3, 66)
  IF LEN(s) <> 0 THEN PRINT "FAIL STRING$ negative" : FUNCTION = 1 : EXIT FUNCTION
  s = SPACE$(5)
  IF LEN(s) <> 5 THEN PRINT "FAIL SPACE$" : FUNCTION = 1 : EXIT FUNCTION
  s = SPACE$(-3)
  IF LEN(s) <> 0 THEN PRINT "FAIL SPACE$ negative" : FUNCTION = 1 : EXIT FUNCTION
  PRINT "batch336 self-check OK"
  FUNCTION = 0
END FUNCTION
