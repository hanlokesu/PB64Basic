#COMPILE EXE
#DIM ALL

' String equates (official CHW equate directive / MyDLL.bas shape)
$CLSID_MYOBJ = "0B1D0A12-1234-ABCD-EF01-23456789ABCD"
$CLSID_MYOBJ2 = "11111111-2222-3333-4444-555555555555"

TYPE TRESERVED
  BYREF AS LONG
  DWORD AS DWORD
  INPUT AS LONG
END TYPE

TYPE TCROSS
  F1 AS LONG
  F2 _
    AS LONG
END TYPE

TYPE TMIX
  A AS LONG
  TRESERVED
END TYPE

FUNCTION PBMAIN () AS LONG
  LOCAL T AS TMIX
  LOCAL C AS TCROSS
  LOCAL s$
  T.A = 11
  T.BYREF = 22
  T.DWORD = 33
  T.INPUT = 44
  C.F1 = 5
  C.F2 = 6
  s$ = $CLSID_MYOBJ
  OPEN "out278b.txt" FOR OUTPUT AS #1
  PRINT #1, T.A
  PRINT #1, T.BYREF
  PRINT #1, T.DWORD
  PRINT #1, T.INPUT
  PRINT #1, C.F1
  PRINT #1, C.F2
  PRINT #1, s$
  PRINT #1, LEN(T)
  CLOSE #1
  FUNCTION = 0
END FUNCTION
